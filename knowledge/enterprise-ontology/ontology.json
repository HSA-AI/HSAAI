        "Employee",
        "Executive",
        "Manager",
        "Contractor",
        "Candidate"
      ]
    },
    {
      "name": "Product",
      "entities": [
        "ProductFamily",
        "Product",
        "SKU",
        "Package",
        "Brand"
      ]
    },
    {
      "name": "Supply",
      "entities": [
        "Supplier",
        "RawMaterial",
        "PurchaseOrder",
        "GoodsReceipt"
      ]
    },
    {
      "name": "Customer",
      "entities": [
        "Customer",
        "Account",
        "Order",
        "Invoice",
        "Payment"
      ]
    },
    {
      "name": "Finance",
      "entities": [
        "Account",
        "CostCenter",
        "JournalEntry",
        "Budget",
        "Forecast"
      ]
    },
    {
      "name": "Document",
