# HSAAI Internal-Only Company Deployment
# Copy to .env.hsa-internal and replace all CHANGE_ME values before deployment.

APP_ENV=production
INTERNAL_ONLY_MODE=true
ALLOW_EXTERNAL_APIS=false
ALLOW_EXTERNAL_AI=false
STRICT_EGRESS_DENY=true
AUTH_REQUIRED=true
ALLOW_DEV_AUTH=false
ALLOW_DEV_RBAC=false
LOCAL_LLM_ENABLED=true
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL=qwen3:8b  # FIX v2.0: Unified with llm_gateway/models.local.json
PRIVATE_NETWORK_CIDR=172.28.0.0/16

# Bind only to company intranet interface. Use 127.0.0.1 for single-server testing.
INTRANET_BIND_IP=127.0.0.1
FRONTEND_URL=http://hsaai.company.local:3000
NEXT_PUBLIC_API_URL=http://hsaai.company.local:8080
CORS_ALLOW_ORIGINS=http://hsaai.company.local:3000,http://localhost:3000
RATE_LIMIT_PER_MINUTE=120

# Secrets: generate offline and keep inside company vault.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
JWT_SECRET=CHANGE_ME_LONG_RANDOM_OFFLINE_SECRET
DATA_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY_32_BYTE_BASE64
FIELD_ENCRYPTION_ENABLED=true
AUDIT_LOG_ENABLED=true
DATA_RETENTION_DAYS=365

# Internal identity provider only.
KEYCLOAK_ISSUER=http://keycloak:8080/realms/hsaai
KEYCLOAK_REALM=hsaai
KEYCLOAK_CLIENT_ID=hsaai-frontend
KEYCLOAK_AUDIENCE=hsaai-api
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG_KEYCLOAK_ADMIN_PASSWORD

# Internal services only.
POSTGRES_DSN=postgresql+psycopg://hsaai:${POSTGRES_PASSWORD}@postgres:5432/hsaai
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
ELASTICSEARCH_URL=http://elasticsearch:9200
OLLAMA_BASE_URL=http://local_llm:11434
LOCAL_LLM_BASE_URL=http://local_llm:11434
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# External AI providers are intentionally disabled in HSAAI internal-only edition.
# Do not define OpenAI/Anthropic/Google/DeepSeek/Mistral/Cohere/Pinecone keys.
SENTRY_DSN=

# Optional: point these to your private registry mirrors for fully offline deployment.
OLLAMA_IMAGE=ollama/ollama:0.3.9
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.11.5
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.15.0
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
GRAFANA_IMAGE=grafana/grafana:11.1.4

KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:25.0.6

# Enterprise system integration placeholders. Keep disabled until IT provides approved endpoints and service accounts.
SAP_S4HANA_ENABLED=false
SAP_S4HANA_BASE_URL=
SAP_S4HANA_TOKEN=
SAP_BYDESIGN_ENABLED=false
SAP_BYDESIGN_BASE_URL=
SAP_BYDESIGN_USERNAME=
SAP_BYDESIGN_PASSWORD=
LDAP_ENABLED=false
LDAP_SERVER_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
SMB_ENABLED=false
SMB_SERVER=
SMB_SHARE=
SMB_DOMAIN=
SMB_USERNAME=
SMB_PASSWORD=
SHAREPOINT_ENABLED=false
SHAREPOINT_SITE_URL=
BI_ENABLED=false
BI_GATEWAY_URL=
HR_SYSTEM_ENABLED=false
HR_SYSTEM_BASE_URL=
ITSM_ENABLED=false
ITSM_BASE_URL=

# HSAAI Local AI Independence
LOCAL_MODEL_STORAGE=./storage/local_models
MODEL_TRAINING_DATASET_DIR=./storage/model_training/datasets
MODEL_TRAINING_OUTPUT_DIR=./storage/model_training/outputs
LOCAL_EMBEDDINGS_MODEL=bge-m3
MODEL_ROUTING_MODE=local-only

# Model Training Runtime
MODEL_TRAINING_EXECUTION_MODE=real  # FIX v2.0: was "simulation" in production example
MODEL_TRAINING_JOBS_DIR=./storage/model_training/jobs
# Set to http://model_training:8093 in Docker internal deployment, or http://localhost:8093 for local dev.
MODEL_TRAINING_SERVICE_URL=http://localhost:8093

# HSAAI Hybrid Model Router
# Default secure mode: local Ollama only.
INTERNAL_ONLY_MODE=true
ALLOW_EXTERNAL_AI=false
LOCAL_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://local_llm:11434
# Optional external mode: set INTERNAL_ONLY_MODE=false and ALLOW_EXTERNAL_AI=true only for non-sensitive workloads.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Knowledge Graph / Neo4j
KNOWLEDGE_GRAPH_ENABLED=true
GRAPH_INGESTION_ENABLED=true
GRAPH_RAG_BRIDGE_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-strong-neo4j-password
