# HSAAI — Native (dockerless) Deployment Environment
# ===================================================
# Copy to a loadable env file or export before running hsaai-ctl.
# SECURITY: placeholders only — never commit real secrets to Git.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# ─── Core data services (native binaries from runtime/rootfs) ───
DATABASE_URL=postgresql+psycopg://hsaai:<REPLACE_ME_DB_PASSWORD>@127.0.0.1:5432/hsaai
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333
POSTGRES_USER=hsaai
POSTGRES_PASSWORD=<REPLACE_ME_DB_PASSWORD>

# ─── Application ─────────────────────────────────────────────
APP_ENV=development            # development | staging | production
USE_ALEMBIC=true               # migrations run via alembic (never auto in prod)
HSAAI_HOME=<REPLACE_ME_PROJECT_ROOT>

# ─── Identity Provider (demo IdP / real Keycloak in production) ───
KEYCLOAK_URL=http://127.0.0.1:9080
KEYCLOAK_REALM=hsaai
KEYCLOAK_CLIENT_ID=hsaai-frontend
KEYCLOAK_CLIENT_SECRET=<REPLACE_ME_CLIENT_SECRET>
KEYCLOAK_ISSUER=http://127.0.0.1:9080/realms/hsaai

# ─── Desktop Gateway (session control plane) ─────────────────
DESKTOP_API_TOKEN=<REPLACE_ME_32HEX_TOKEN>   # auto-pinned by hsaai-ctl to runtime/desktop-gateway-token.txt

# ─── LLM providers (fill only what you use) ──────────────────
OPENAI_API_KEY=<REPLACE_ME>
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=<REPLACE_ME>

# ─── Object storage / MLflow (compose-only stack; optional) ──
AWS_ACCESS_KEY_ID=<REPLACE_ME>
AWS_SECRET_ACCESS_KEY=<REPLACE_ME>
MLFLOW_S3_ENDPOINT_URL=<REPLACE_ME>

# ─── Notes ───────────────────────────────────────────────────
# - Never expose 5432/6333/6379/5999 beyond localhost.
# - Only 3000 (web), 8000 (backend), 6080 (noVNC), 8600 (gateway) are user-facing.
# - Rotate KEYCLOAK_CLIENT_SECRET and POSTGRES_PASSWORD per environment.
