{
  "openapi": "3.1.0",
  "info": {
    "title": "HSAAI Local LLM Gateway",
    "version": "4.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "summary": "List Models",
        "operationId": "list_models_v1_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/models/route": {
      "post": {
        "summary": "Route",
        "operationId": "route_v1_models_route_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/generate": {
      "post": {
        "summary": "Generate",
        "description": "Generate a response using the routed LLM.\n\nFIX v2.2 (Phase 2): Now with:\n  1. Semantic cache check — if a semantically similar query was answered\n     recently (within 24h), return the cached response instantly (saving\n     LLM cost + latency).\n  2. Token budget enforcement — per-tenant daily token limit. Requests\n     that would exceed the budget are rejected with HTTP 429.\n  3. Token usage tracking — actual tokens consumed are recorded for\n     FinOps analytics and budget enforcement.",
        "operationId": "generate_v1_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/stream": {
      "post": {
        "summary": "Stream",
        "description": "Stream tokens via Server-Sent Events.\n\nv4.0 (AI-IMPROVEMENTS):\n  - Token-by-token SSE with `data: {token: ...}` events.\n  - `event: metrics` final event with `tokens_per_sec`,\n    `time_to_first_token_ms`, `total_tokens`, `dropped_tokens`.\n  - Backpressure: if the client is slow, we buffer up to\n    STREAM_MAX_BUFFER_TOKENS (default 256) and then drop oldest.\n  - Cancellation: if the client disconnects, the upstream Ollama\n    call is cancelled via httpx's async context manager exit.\n  - Token budget: emitted tokens are counted and charged to the\n    tenant's daily budget via `_consume_token_budget`.\n\nThe endpoint accepts the same `GenerateRequest` body as `/v1/generate`.\nSet `stream=True` is implicit (this endpoint always streams).\n\nRequires Ollama as the LLM backend (no stub streaming in production).",
        "operationId": "stream_v1_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/stream/health": {
      "get": {
        "summary": "Stream Health",
        "description": "Health check for the streaming endpoint.\n\nReports streaming configuration so operators can verify backpressure\nand cancellation settings without making a real stream request.",
        "operationId": "stream_health_v1_stream_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness",
        "operationId": "readiness_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GenerateRequest": {
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Prompt"
          },
          "system": {
            "type": "string",
            "title": "System",
            "default": "You are HSAAI, a private enterprise AI assistant."
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "temperature": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Temperature",
            "default": 0.2
          },
          "max_tokens": {
            "type": "integer",
            "maximum": 32768.0,
            "minimum": 1.0,
            "title": "Max Tokens",
            "default": 1024
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": false
          },
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id",
            "default": "default"
          },
          "workspace_id": {
            "type": "string",
            "title": "Workspace Id",
            "default": "default"
          },
          "task": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task"
          },
          "sensitivity": {
            "type": "string",
            "title": "Sensitivity",
            "default": "internal"
          }
        },
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "GenerateRequest"
      },
      "GenerateResponse": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "local_only": {
            "type": "boolean",
            "title": "Local Only"
          },
          "elapsed_ms": {
            "type": "integer",
            "title": "Elapsed Ms"
          },
          "route_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Route Reason"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "model",
          "text",
          "local_only",
          "elapsed_ms"
        ],
        "title": "GenerateResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RouteRequest": {
        "properties": {
          "prompt": {
            "type": "string",
            "title": "Prompt",
            "default": ""
          },
          "task": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task"
          },
          "sensitivity": {
            "type": "string",
            "title": "Sensitivity",
            "default": "internal"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          }
        },
        "type": "object",
        "title": "RouteRequest"
      },
      "RouteResponse": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model_key": {
            "type": "string",
            "title": "Model Key"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "local_only": {
            "type": "boolean",
            "title": "Local Only"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "model_key",
          "model",
          "reason",
          "local_only"
        ],
        "title": "RouteResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}