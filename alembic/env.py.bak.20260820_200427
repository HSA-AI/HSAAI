from __future__ import annotations

import os
import sys
from logging.config import fileConfig

import sqlalchemy as sa
from alembic import context
from sqlalchemy import engine_from_config
from sqlalchemy import pool


# ============================================================
# HSAAI ALEMBIC ENVIRONMENT
# ============================================================
#
# Purpose:
#   - Load all HSAAI SQLAlchemy models
#   - Support services/ packages
#   - Build a single metadata object for Alembic
#   - Avoid duplicate table-key errors caused by multiple
#     Declarative Base metadata objects
#
# Database:
#   PostgreSQL
#
# Current migration chain:
#   0001 -> 0002 -> 0003 -> 0004 -> 0005
#
# IMPORTANT:
#   This file does NOT modify the database by itself.
#
# ============================================================


# ------------------------------------------------------------
# Project paths
# ------------------------------------------------------------

PROJECT_ROOT = os.path.abspath(
    os.path.join(os.path.dirname(__file__), "..")
)

SERVICES_ROOT = os.path.join(PROJECT_ROOT, "services")


if PROJECT_ROOT not in sys.path:
    sys.path.insert(0, PROJECT_ROOT)

if SERVICES_ROOT not in sys.path:
    sys.path.insert(0, SERVICES_ROOT)


# ------------------------------------------------------------
# Alembic configuration
