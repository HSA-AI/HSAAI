config = context.config


# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

if config.config_file_name is not None:
    fileConfig(config.config_file_name)


# ============================================================
# MODEL REGISTRATION
# ============================================================

_all_metadata: list[sa.MetaData] = []


MODEL_MODULES = [
    # Core
    "backend_core.db.models",

    # Knowledge Graph
    "backend_core.knowledge_graph.graph_models",

    # Smart Responses
    "backend_core.smart_responses.models",

    # Maturity
    "backend_core.maturity_upgrade.models",

    # Enterprise OS
    "backend_core.enterprise_os.models",

    # Enterprise Integrations
    "backend_core.enterprise_integrations.models",

    # Enterprise Upgrade
    "backend_core.enterprise_upgrade.domain",

    # Model Training
    "model_training.db.models",
]


def _import_models() -> None:
    """
    Import all SQLAlchemy model modules.

    Each module may expose its own Declarative Base.
    We collect every metadata object and later merge the
    tables into one Alembic metadata object.
    """

    for module_name in MODEL_MODULES:
        try:
            module = __import__(
                module_name,
                fromlist=["Base"],
            )

            base = getattr(module, "Base", None)

            if base is None:
                print(
                    f"  WARNING: {module_name} has no Base attribute"
                )
                continue

            metadata = getattr(base, "metadata", None)

            if metadata is None:
                print(
                    f"  WARNING: {module_name} has no metadata"
                )
                continue

            _all_metadata.append(metadata)

            print(
                f"  Registered metadata from {module_name}"
            )

        except ImportError as exc:
            print(
                f"  WARNING: Could not import "
                f"{module_name}: {exc}"
            )

        except Exception as exc:
            print(
                f"  WARNING: Error loading "
                f"{module_name}: {exc}"
            )


# ============================================================
# METADATA MERGING
# ============================================================


def _build_combined_metadata() -> sa.MetaData:
    """
    Build one SQLAlchemy MetaData object from all registered
    metadata objects.

    Alembic's autogenerate requires table keys to be unique.

    Several HSAAI modules currently expose overlapping tables
    through different Declarative Base objects. If those
    metadata objects are passed directly to Alembic, Alembic
    raises:

        ValueError:
        Duplicate table keys across multiple MetaData objects

    Therefore all tables are copied into one canonical
    MetaData object.

    First registration wins when the same table key appears
    more than once.
    """

    combined = sa.MetaData()

    for metadata in _all_metadata:

        for table in metadata.sorted_tables:

            table_key = table.key

            if table_key in combined.tables:
                print(
                    f"  Skipping duplicate table metadata: "
                    f"{table_key}"
                )
                continue

            table.to_metadata(combined)

    return combined


# Import all model modules.
_import_models()

# Build one metadata object for Alembic.
target_metadata = _build_combined_metadata()


# ============================================================
# DATABASE URL
# ============================================================


def get_database_url() -> str | None:
    """
    Resolve the database URL.

    Priority:
        1. DATABASE_URL environment variable
        2. sqlalchemy.url from alembic.ini

    DATABASE_URL is preferred because it allows deployment
    environments to inject credentials without storing them
    in alembic.ini.
    """

    database_url = os.getenv("DATABASE_URL")

    if database_url:
        return database_url

    return config.get_main_option("sqlalchemy.url")


# ============================================================
# OFFLINE MIGRATIONS
# ============================================================


def run_migrations_offline() -> None:
    """
    Run migrations without creating a database connection.
    """

    database_url = get_database_url()

    if not database_url:
        raise RuntimeError(
            "Database URL is not configured. "
            "Set DATABASE_URL or sqlalchemy.url in alembic.ini."
        )

    context.configure(
        url=database_url,
        target_metadata=target_metadata,
        literal_binds=True,
        dialect_opts={
            "paramstyle": "named",
        },
        compare_type=True,
        compare_server_default=True,
        include_schemas=False,
    )

    with context.begin_transaction():
        context.run_migrations()


# ============================================================
# ONLINE MIGRATIONS
# ============================================================


def run_migrations_online() -> None:
    """
    Run migrations using a live PostgreSQL connection.
    """

    database_url = get_database_url()

    if database_url:
        configuration = config.get_section(
            config.config_ini_section,
            {},
        )

        if configuration is None:
            configuration = {}

        configuration["sqlalchemy.url"] = database_url

    else:
        configuration = config.get_section(
            config.config_ini_section,
            {},
        )

        if configuration is None:
            raise RuntimeError(
                "Unable to load Alembic configuration."
            )

        if not configuration.get("sqlalchemy.url"):
            raise RuntimeError(
                "Database URL is not configured. "
                "Set DATABASE_URL or sqlalchemy.url in alembic.ini."
            )

    connectable = engine_from_config(
        configuration,
        prefix="sqlalchemy.",
        poolclass=pool.NullPool,
    )

    with connectable.connect() as connection:

        context.configure(
            connection=connection,
            target_metadata=target_metadata,

            # Schema comparison
            compare_type=True,
            compare_server_default=True,

            # PostgreSQL
            include_schemas=False,

            # Do not render SQLAlchemy naming noise
            render_as_batch=False,
        )

        with context.begin_transaction():
            context.run_migrations()


# ============================================================
# ENTRY POINT
# ============================================================


if context.is_offline_mode():
    run_migrations_offline()
else:
    run_migrations_online()
