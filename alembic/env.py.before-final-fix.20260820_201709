from __future__ import annotations

import os
import sys
from logging.config import fileConfig

from alembic import context
from sqlalchemy import engine_from_config, pool, MetaData


# ============================================================
# PATH SETUP
# ============================================================

PROJECT_ROOT = os.path.abspath(
    os.path.join(os.path.dirname(__file__), "..")
)

SERVICES_ROOT = os.path.join(PROJECT_ROOT, "services")

if PROJECT_ROOT not in sys.path:
    sys.path.insert(0, PROJECT_ROOT)

if SERVICES_ROOT not in sys.path:
    sys.path.insert(0, SERVICES_ROOT)


# ============================================================
# ALEMBIC CONFIG
# ============================================================

config = context.config

if config.config_file_name is not None:
    fileConfig(config.config_file_name)


# ============================================================
# MODEL MODULES
# ============================================================

MODEL_MODULES = [
    "backend_core.db.models",
    "backend_core.knowledge_graph.graph_models",
    "backend_core.smart_responses.models",
    "backend_core.maturity_upgrade.models",
    "backend_core.enterprise_os.models",
    "backend_core.enterprise_integrations.models",
    "backend_core.enterprise_upgrade.domain",
    "model_training.db.models",
]


# ============================================================
# IMPORT ALL METADATA
# ============================================================

def _import_model_metadata() -> list[MetaData]:
    """
    Import all SQLAlchemy model modules.

    Each module may expose:
        Base.metadata

    Multiple model packages can contain references to the same
    physical database tables. Alembic cannot receive duplicate
    table keys across multiple MetaData objects, therefore the
    metadata objects are collected first and merged safely later.
    """

    metadata_list: list[MetaData] = []

    for module_name in MODEL_MODULES:
        try:
            module = __import__(
                module_name,
                fromlist=["Base"],
            )

            base = getattr(module, "Base", None)

            if base is None:
                print(
                    f"  WARNING: {module_name} has no Base; skipped"
                )
                continue

            metadata = getattr(base, "metadata", None)

            if metadata is None:
                print(
                    f"  WARNING: {module_name} has no metadata; skipped"
                )
                continue

            metadata_list.append(metadata)

            print(
                f"  Registered metadata from {module_name}"
            )

        except ImportError as exc:
            print(
                f"  WARNING: Could not import "
                f"{module_name}: {exc}"
            )

        except Exception as exc:
            print(
                f"  WARNING: Error loading "
                f"{module_name}: {exc}"
            )

    return metadata_list


# ============================================================
# BUILD ONE ALEMBIC METADATA
# ============================================================

def _build_target_metadata() -> MetaData:
    """
    Build a single canonical MetaData object for Alembic.

    Important:
    Several HSAAI model packages reference the same physical
    tables. Alembic raises:

        ValueError:
        Duplicate table keys across multiple MetaData objects

    To avoid this, every physical table key is included only once.

    The first metadata definition wins.
    """

    source_metadata = _import_model_metadata()

    target_metadata = MetaData()

    seen_tables: set[str] = set()

    for metadata in source_metadata:
        for table in metadata.sorted_tables:
            table_key = table.key

            if table_key in seen_tables:
                print(
                    f"  Skipping duplicate table metadata: "
                    f"{table_key}"
                )
                continue

            try:
                table.to_metadata(target_metadata)

                seen_tables.add(table_key)

            except Exception as exc:
                print(
                    f"  WARNING: Could not copy table "
                    f"{table_key}: {exc}"
                )

    return target_metadata


target_metadata = _build_target_metadata()


# ============================================================
# DATABASE URL
# ============================================================

def _get_database_url() -> str | None:
    """
    Prefer SQLALCHEMY_DATABASE_URL / DATABASE_URL from the
    environment.

    If Alembic already has sqlalchemy.url in alembic.ini,
    that value is preserved.
    """

    env_url = (
        os.getenv("SQLALCHEMY_DATABASE_URL")
        or os.getenv("DATABASE_URL")
    )

    if env_url:
        return env_url

    return config.get_main_option("sqlalchemy.url")


database_url = _get_database_url()

if database_url:
    config.set_main_option(
        "sqlalchemy.url",
        database_url,
    )


# ============================================================
# OFFLINE MIGRATIONS
# ============================================================

def run_migrations_offline() -> None:
    """
    Run migrations without creating a database connection.
    """

    url = config.get_main_option("sqlalchemy.url")

    context.configure(
        url=url,
        target_metadata=target_metadata,
        literal_binds=True,
        dialect_opts={
            "paramstyle": "named",
        },
        compare_type=True,
        compare_server_default=True,
    )

    with context.begin_transaction():
        context.run_migrations()


# ============================================================
# ONLINE MIGRATIONS
# ============================================================

def run_migrations_online() -> None:
    """
    Run migrations using a live database connection.
    """

    connectable = engine_from_config(
        config.get_section(config.config_ini_section, {}),
        prefix="sqlalchemy.",
        poolclass=pool.NullPool,
        future=True,
    )

    with connectable.connect() as connection:
        context.configure(
            connection=connection,
            target_metadata=target_metadata,
            compare_type=True,
            compare_server_default=True,
        )

        with context.begin_transaction():
            context.run_migrations()


# ============================================================
# ENTRY POINT
# ============================================================

if context.is_offline_mode():
    run_migrations_offline()
else:
    run_migrations_online()
