{
  "schema": "hsaai.department-agent.v1",
  "agent_id": "AGENT-EXEC",
  "name_ar": "الوكيل التنفيذي",
  "name_en": "Executive Agent",
  "directory": "executive-agent",
  "department_ref": "DEPT-EXEC",
  "role_ar": "دعم القيادة التنفيذية في اتخاذ القرارات الاستراتيجية",
  "role_en": "Support executive leadership in strategic decision-making",
  "model_tier": "premium",
  "languages": [
    "ar",
    "en"
  ],
  "tools": [
    "rag_search",
    "knowledge_graph_query",
    "power_bi_query",
    "executive_dashboard",
    "approve_workflow"
  ],
  "safety": {
    "human_in_the_loop": true,
    "audit_all_calls": true,
    "pii_detection": true,
    "prompt_firewall": true,
    "constitutional_ai": true,
    "kill_switch": true
  },
  "runtime": {
    "service": "services/multi_agents/",
    "registration": "AgentRegistry",
    "config_source": "agent.json + prompt-system.md"
  },
  "evaluation_targets": {
    "task_success_rate": 0.9,
    "hallucination_rate_max": 0.05,
    "csat_min": 4.5,
    "latency_p95_seconds": 3,
    "cost_per_query_max_usd": 0.05
  }
}