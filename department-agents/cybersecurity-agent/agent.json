{
  "schema": "hsaai.department-agent.v1",
  "agent_id": "AGENT-CYBERSECURITY",
  "name_ar": "وكيل الأمن السيبراني",
  "name_en": "Cybersecurity Agent",
  "directory": "cybersecurity-agent",
  "department_ref": "DEPT-SEC",
  "role_ar": "تحليل التهديدات، التحقيق في الحوادث، ومراقبة الوضع الأمني",
  "role_en": "Analyze threats, investigate incidents, monitor security posture",
  "model_tier": "premium",
  "languages": [
    "ar",
    "en"
  ],
  "tools": [
    "rag_search",
    "siem_query",
    "vault_query",
    "anomaly_detect",
    "create_incident"
  ],
  "safety": {
    "human_in_the_loop": true,
    "audit_all_calls": true,
    "pii_detection": true,
    "prompt_firewall": true,
    "constitutional_ai": true,
    "kill_switch": true
  },
  "runtime": {
    "service": "services/multi_agents/",
    "registration": "AgentRegistry",
    "config_source": "agent.json + prompt-system.md"
  },
  "evaluation_targets": {
    "task_success_rate": 0.9,
    "hallucination_rate_max": 0.05,
    "csat_min": 4.5,
    "latency_p95_seconds": 3,
    "cost_per_query_max_usd": 0.05
  }
}