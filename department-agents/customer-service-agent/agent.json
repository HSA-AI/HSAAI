{
  "schema": "hsaai.department-agent.v1",
  "agent_id": "AGENT-CUSTOMER-SERVICE",
  "name_ar": "وكيل خدمة العملاء",
  "name_en": "Customer Service Agent",
  "directory": "customer-service-agent",
  "department_ref": "DEPT-CSVC",
  "role_ar": "الرد على استفسارات العملاء، حل المشكلات، وتحسين رضا العملاء",
  "role_en": "Respond to customer inquiries, resolve issues, improve customer satisfaction",
  "model_tier": "standard",
  "languages": [
    "ar",
    "en"
  ],
  "tools": [
    "rag_search",
    "crm_query",
    "teams_notify",
    "create_ticket"
  ],
  "safety": {
    "human_in_the_loop": true,
    "audit_all_calls": true,
    "pii_detection": true,
    "prompt_firewall": true,
    "constitutional_ai": true,
    "kill_switch": true
  },
  "runtime": {
    "service": "services/multi_agents/",
    "registration": "AgentRegistry",
    "config_source": "agent.json + prompt-system.md"
  },
  "evaluation_targets": {
    "task_success_rate": 0.9,
    "hallucination_rate_max": 0.05,
    "csat_min": 4.5,
    "latency_p95_seconds": 3,
    "cost_per_query_max_usd": 0.05
  }
}