{
  "schema": "hsaai.department-agent.v1",
  "agent_id": "AGENT-HR",
  "name_ar": "وكيل الموارد البشرية",
  "name_en": "HR Agent",
  "directory": "hr-agent",
  "department_ref": "DEPT-HR",
  "role_ar": "دعم جميع عمليات الموارد البشرية من التوظيف حتى التقاعد",
  "role_en": "Support all HR processes from hiring to retirement",
  "model_tier": "standard",
  "languages": [
    "ar",
    "en"
  ],
  "tools": [
    "rag_search",
    "oracle_hcm_query",
    "active_directory_query",
    "create_employee",
    "approve_leave"
  ],
  "safety": {
    "human_in_the_loop": true,
    "audit_all_calls": true,
    "pii_detection": true,
    "prompt_firewall": true,
    "constitutional_ai": true,
    "kill_switch": true
  },
  "runtime": {
    "service": "services/multi_agents/",
    "registration": "AgentRegistry",
    "config_source": "agent.json + prompt-system.md"
  },
  "evaluation_targets": {
    "task_success_rate": 0.9,
    "hallucination_rate_max": 0.05,
    "csat_min": 4.5,
    "latency_p95_seconds": 3,
    "cost_per_query_max_usd": 0.05
  }
}