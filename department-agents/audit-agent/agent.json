{
  "schema": "hsaai.department-agent.v1",
  "agent_id": "AGENT-AUDIT",
  "name_ar": "وكيل التدقيق",
  "name_en": "Audit Agent",
  "directory": "audit-agent",
  "department_ref": "DEPT-AUD",
  "role_ar": "دعم التدقيق الداخلي بتحليل البيانات واكتشاف الأنماط المشبوهة",
  "role_en": "Support internal audit with data analysis and anomaly detection",
  "model_tier": "premium",
  "languages": [
    "ar",
    "en"
  ],
  "tools": [
    "rag_search",
    "sql_query",
    "power_bi_query",
    "anomaly_detect",
    "create_audit_finding"
  ],
  "safety": {
    "human_in_the_loop": true,
    "audit_all_calls": true,
    "pii_detection": true,
    "prompt_firewall": true,
    "constitutional_ai": true,
    "kill_switch": true
  },
  "runtime": {
    "service": "services/multi_agents/",
    "registration": "AgentRegistry",
    "config_source": "agent.json + prompt-system.md"
  },
  "evaluation_targets": {
    "task_success_rate": 0.9,
    "hallucination_rate_max": 0.05,
    "csat_min": 4.5,
    "latency_p95_seconds": 3,
    "cost_per_query_max_usd": 0.05
  }
}