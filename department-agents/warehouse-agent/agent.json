{
  "schema": "hsaai.department-agent.v1",
  "agent_id": "AGENT-WAREHOUSE",
  "name_ar": "وكيل المستودعات",
  "name_en": "Warehouse Agent",
  "directory": "warehouse-agent",
  "department_ref": "DEPT-WRH",
  "role_ar": "إدارة المخزون، تحسين التخزين، وتتبع العمليات اللوجستية للمستودع",
  "role_en": "Manage inventory, optimize storage, track warehouse operations",
  "model_tier": "standard",
  "languages": [
    "ar",
    "en"
  ],
  "tools": [
    "rag_search",
    "wms_query",
    "redis_query",
    "create_transfer_order"
  ],
  "safety": {
    "human_in_the_loop": true,
    "audit_all_calls": true,
    "pii_detection": true,
    "prompt_firewall": true,
    "constitutional_ai": true,
    "kill_switch": true
  },
  "runtime": {
    "service": "services/multi_agents/",
    "registration": "AgentRegistry",
    "config_source": "agent.json + prompt-system.md"
  },
  "evaluation_targets": {
    "task_success_rate": 0.9,
    "hallucination_rate_max": 0.05,
    "csat_min": 4.5,
    "latency_p95_seconds": 3,
    "cost_per_query_max_usd": 0.05
  }
}