{
  "schema": "hsaai.department-agent.v1",
  "agent_id": "AGENT-MANUFACTURING",
  "name_ar": "وكيل التصنيع",
  "name_en": "Manufacturing Agent",
  "directory": "manufacturing-agent",
  "department_ref": "DEPT-MFG",
  "role_ar": "تحسين عمليات التصنيع، تحليل OEE، والتنبؤ بالأعطال",
  "role_en": "Optimize manufacturing operations, analyze OEE, predict failures",
  "model_tier": "standard",
  "languages": [
    "ar",
    "en"
  ],
  "tools": [
    "rag_search",
    "mes_query",
    "kafka_consume",
    "anomaly_detect",
    "create_work_order"
  ],
  "safety": {
    "human_in_the_loop": true,
    "audit_all_calls": true,
    "pii_detection": true,
    "prompt_firewall": true,
    "constitutional_ai": true,
    "kill_switch": true
  },
  "runtime": {
    "service": "services/multi_agents/",
    "registration": "AgentRegistry",
    "config_source": "agent.json + prompt-system.md"
  },
  "evaluation_targets": {
    "task_success_rate": 0.9,
    "hallucination_rate_max": 0.05,
    "csat_min": 4.5,
    "latency_p95_seconds": 3,
    "cost_per_query_max_usd": 0.05
  }
}