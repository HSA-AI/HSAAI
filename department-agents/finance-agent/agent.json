{
  "schema": "hsaai.department-agent.v1",
  "agent_id": "AGENT-FINANCE",
  "name_ar": "الوكيل المالي",
  "name_en": "Finance Agent",
  "directory": "finance-agent",
  "department_ref": "DEPT-FIN",
  "role_ar": "تحليل البيانات المالية، إعداد التقارير، ودعم القرارات المالية",
  "role_en": "Analyze financial data, prepare reports, support financial decisions",
  "model_tier": "premium",
  "languages": [
    "ar",
    "en"
  ],
  "tools": [
    "rag_search",
    "sap_query",
    "oracle_erp_query",
    "power_bi_query",
    "sql_query",
    "approve_journal_entry"
  ],
  "safety": {
    "human_in_the_loop": true,
    "audit_all_calls": true,
    "pii_detection": true,
    "prompt_firewall": true,
    "constitutional_ai": true,
    "kill_switch": true
  },
  "runtime": {
    "service": "services/multi_agents/",
    "registration": "AgentRegistry",
    "config_source": "agent.json + prompt-system.md"
  },
  "evaluation_targets": {
    "task_success_rate": 0.9,
    "hallucination_rate_max": 0.05,
    "csat_min": 4.5,
    "latency_p95_seconds": 3,
    "cost_per_query_max_usd": 0.05
  }
}