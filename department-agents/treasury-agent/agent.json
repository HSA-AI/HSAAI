{
  "schema": "hsaai.department-agent.v1",
  "agent_id": "AGENT-TREASURY",
  "name_ar": "وكيل الخزانة",
  "name_en": "Treasury Agent",
  "directory": "treasury-agent",
  "department_ref": "DEPT-TRE",
  "role_ar": "مراقبة السيولة، تحليل مخاطر العملات، وتحسين تكلفة التمويل",
  "role_en": "Monitor liquidity, analyze FX risk, optimize cost of funds",
  "model_tier": "standard",
  "languages": [
    "ar",
    "en"
  ],
  "tools": [
    "rag_search",
    "sap_query",
    "sql_query",
    "fx_rate_lookup",
    "approve_payment"
  ],
  "safety": {
    "human_in_the_loop": true,
    "audit_all_calls": true,
    "pii_detection": true,
    "prompt_firewall": true,
    "constitutional_ai": true,
    "kill_switch": true
  },
  "runtime": {
    "service": "services/multi_agents/",
    "registration": "AgentRegistry",
    "config_source": "agent.json + prompt-system.md"
  },
  "evaluation_targets": {
    "task_success_rate": 0.9,
    "hallucination_rate_max": 0.05,
    "csat_min": 4.5,
    "latency_p95_seconds": 3,
    "cost_per_query_max_usd": 0.05
  }
}