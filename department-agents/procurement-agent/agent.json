{
  "schema": "hsaai.department-agent.v1",
  "agent_id": "AGENT-PROCUREMENT",
  "name_ar": "وكيل المشتريات",
  "name_en": "Procurement Agent",
  "directory": "procurement-agent",
  "department_ref": "DEPT-PROC",
  "role_ar": "تحليل الموردين، مقارنة عروض الأسعار، ودعم دورة المشتريات",
  "role_en": "Analyze suppliers, compare RFQs, support procurement cycle",
  "model_tier": "standard",
  "languages": [
    "ar",
    "en"
  ],
  "tools": [
    "rag_search",
    "sap_query",
    "oracle_erp_query",
    "create_po",
    "approve_po"
  ],
  "safety": {
    "human_in_the_loop": true,
    "audit_all_calls": true,
    "pii_detection": true,
    "prompt_firewall": true,
    "constitutional_ai": true,
    "kill_switch": true
  },
  "runtime": {
    "service": "services/multi_agents/",
    "registration": "AgentRegistry",
    "config_source": "agent.json + prompt-system.md"
  },
  "evaluation_targets": {
    "task_success_rate": 0.9,
    "hallucination_rate_max": 0.05,
    "csat_min": 4.5,
    "latency_p95_seconds": 3,
    "cost_per_query_max_usd": 0.05
  }
}