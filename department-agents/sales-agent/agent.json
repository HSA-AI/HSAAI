{
  "schema": "hsaai.department-agent.v1",
  "agent_id": "AGENT-SALES",
  "name_ar": "وكيل المبيعات",
  "name_en": "Sales Agent",
  "directory": "sales-agent",
  "department_ref": "DEPT-SALES",
  "role_ar": "تحليل فرص البيع، التنبؤ بالإيرادات، ودعم فريق المبيعات",
  "role_en": "Analyze sales opportunities, forecast revenue, support sales team",
  "model_tier": "standard",
  "languages": [
    "ar",
    "en"
  ],
  "tools": [
    "rag_search",
    "crm_query",
    "power_bi_query",
    "create_opportunity"
  ],
  "safety": {
    "human_in_the_loop": true,
    "audit_all_calls": true,
    "pii_detection": true,
    "prompt_firewall": true,
    "constitutional_ai": true,
    "kill_switch": true
  },
  "runtime": {
    "service": "services/multi_agents/",
    "registration": "AgentRegistry",
    "config_source": "agent.json + prompt-system.md"
  },
  "evaluation_targets": {
    "task_success_rate": 0.9,
    "hallucination_rate_max": 0.05,
    "csat_min": 4.5,
    "latency_p95_seconds": 3,
    "cost_per_query_max_usd": 0.05
  }
}