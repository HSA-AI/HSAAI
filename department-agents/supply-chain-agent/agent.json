{
  "schema": "hsaai.department-agent.v1",
  "agent_id": "AGENT-SUPPLY-CHAIN",
  "name_ar": "وكيل سلسلة الإمداد",
  "name_en": "Supply Chain Agent",
  "directory": "supply-chain-agent",
  "department_ref": "DEPT-SCM",
  "role_ar": "تخطيط الطلب، تحسين المخزون، والتنبؤ بسلسلة الإمداد",
  "role_en": "Demand planning, inventory optimization, supply chain forecasting",
  "model_tier": "premium",
  "languages": [
    "ar",
    "en"
  ],
  "tools": [
    "rag_search",
    "sap_query",
    "wms_query",
    "kafka_consume",
    "create_po",
    "approve_forecast"
  ],
  "safety": {
    "human_in_the_loop": true,
    "audit_all_calls": true,
    "pii_detection": true,
    "prompt_firewall": true,
    "constitutional_ai": true,
    "kill_switch": true
  },
  "runtime": {
    "service": "services/multi_agents/",
    "registration": "AgentRegistry",
    "config_source": "agent.json + prompt-system.md"
  },
  "evaluation_targets": {
    "task_success_rate": 0.9,
    "hallucination_rate_max": 0.05,
    "csat_min": 4.5,
    "latency_p95_seconds": 3,
    "cost_per_query_max_usd": 0.05
  }
}