<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    OWASP MASVS-NETWORK-1 / MASVS-NETWORK-2: All network traffic uses TLS.
    Network state is required for connectivity checks; INTERNET for API access.
  -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <uses-permission android:name="android.permission.INTERNET"/>

  <!--
    POST_NOTIFICATIONS: required for HSAAI governance / approval push notifications.
    Runtime permission requested in-app (Android 13+).
  -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

  <!--
    MASVS-AUTH-1 / MASVS-CRYPTO-1: Use Android Keystore-backed biometrics.
    USE_BIOMETRIC is the modern permission (no USE_FINGERPRINT needed for API 24+).
  -->
  <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
  <uses-permission android:name="android.permission.VIBRATE"/>

  <!--
    REMOVED permissions (security hardening):

    WRITE_EXTERNAL_STORAGE  — Removed. Deprecated in API 29; use Scoped Storage
                             or the system Photo Picker. MASVS-STORAGE-2.
    READ_EXTERNAL_STORAGE   — Removed. Use the system Photo Picker via
                             expo-image-picker (returns content:// URIs that
                             require no storage permission). MASVS-STORAGE-2.
    SYSTEM_ALERT_WINDOW     — Removed. Not needed for an enterprise app;
                             draw-over-other-apps is an abuse vector
                             (tap-jacking / phishing overlays). MASVS-UI-1.
  -->

  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>

  <!--
    ────────────────────────────────────────────────────────────────────────
    APPLICATION — security-hardened configuration
    ────────────────────────────────────────────────────────────────────────
    OWASP MASVS Controls Addressed:
      MASVS-STORAGE-1 : allowBackup=false, fullBackupContent=false,
                        dataExtractionRules denies all domains.
      MASVS-NETWORK-1 : usesCleartextTraffic=false, networkSecurityConfig
                        denies cleartext globally (only dev localhost is
                        exempt in debug builds).
      MASVS-RESILIENCE-1 : debuggable=false prevents the release APK from
                           being attached by jdb / adb debuggers.
      MASVS-RESILIENCE-3 : taskAffinity="" + allowTaskReparenting=false
                           prevents task-hijacking / phishing attacks where
                           a malicious activity reuses our task to spoof UI.

    FLAG_SECURE: The actual setWindowFlag(FLAG_SECURE) call is implemented
                 in MainActivity.kt's onCreate() via a NativeModule that is
                 invoked from JS through SecurityModule.ts
                 (see mobile/src/security/SecurityModule.ts and
                  mobile/src/security/useSecureScreen.ts). FLAG_SECURE blocks
                 screenshots and screen recording on sensitive screens
                 (login, chat, document viewer) per MASVS-STORAGE-7 /
                 MASVS-RESILIENCE-9.
    ────────────────────────────────────────────────────────────────────────
  -->
  <application
    android:name=".MainApplication"
    android:label="@string/app_name"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:allowBackup="false"
    android:fullBackupContent="false"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:networkSecurityConfig="@xml/network_security_config"
    android:usesCleartextTraffic="false"
    android:debuggable="false"
    android:allowTaskReparenting="false"
    android:taskAffinity=""
    android:theme="@style/AppTheme">

    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>

    <activity
      android:name=".MainActivity"
      android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode"
      android:launchMode="singleTask"
      android:windowSoftInputMode="adjustResize"
      android:theme="@style/Theme.App.SplashScreen"
      android:exported="true"
      android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="hsaai"/>
        <data android:scheme="com.hsa.hsaai"/>
      </intent-filter>
    </activity>

    <!--
      DevSettingsActivity: React Native developer menu (reload bundle, etc).
      MUST remain exported=false so a malicious app cannot launch the dev
      menu on production devices (which would expose the in-app JS bundle
      download URL). Verified as false here — MASVS-RESILIENCE-2.
    -->
    <activity
      android:name="com.facebook.react.devsupport.DevSettingsActivity"
      android:exported="false"
      android:taskAffinity=""
      android:allowTaskReparenting="false"/>
  </application>
</manifest>
