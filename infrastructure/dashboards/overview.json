{
  "annotations": {"list": []},
  "title": "HSAAI Platform Overview",
  "uid": "hsaai-overview",
  "version": 1,
  "timezone": "browser",
  "schemaVersion": 38,
  "tags": ["hsaai", "overview"],
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Request Rate (req/s)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(rate(hsaai_requests_total[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 2, "type": "stat", "title": "Error Rate (%)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "sum(rate(hsaai_requests_total{status=~\"5..\"}[5m])) / sum(rate(hsaai_requests_total[5m])) * 100", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}}
    },
    {
      "id": 3, "type": "stat", "title": "P99 Latency (ms)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.99, sum(rate(hsaai_request_duration_seconds_bucket[5m])) by (le)) * 1000", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ms"}}
    },
    {
      "id": 4, "type": "stat", "title": "Active Services",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "count(up{job=\"hsaai-services\"} == 1)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 5, "type": "timeseries", "title": "Request Rate by Service",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [{"expr": "sum(rate(hsaai_requests_total[5m])) by (service)", "refId": "A", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 6, "type": "timeseries", "title": "LLM Tokens / sec",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{"expr": "sum(rate(hsaai_llm_tokens_total[5m])) by (model)", "refId": "A", "legendFormat": "{{model}}"}]
    },
    {
      "id": 7, "type": "timeseries", "title": "Cache Hit Rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [{"expr": "sum(rate(hsaai_cache_hits_total[5m])) / (sum(rate(hsaai_cache_hits_total[5m])) + sum(rate(hsaai_cache_misses_total[5m]))) * 100", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "id": 8, "type": "timeseries", "title": "Agent Actions / sec",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [{"expr": "sum(rate(hsaai_agent_actions_total[5m])) by (action)", "refId": "A", "legendFormat": "{{action}}"}]
    }
  ]
}
