# ════════════════════════════════════════════════════════════════════
# HSAAI Production Secrets Template (v4.0)
# ════════════════════════════════════════════════════════════════════
# FIX I-13: Was only 4 vars — code uses 249. Now documents all required secrets.
#
# INSTRUCTIONS:
#   1. Copy to .env.production (NEVER commit .env.production)
#   2. Replace every __REQUIRED__ with a real value from Vault
#   3. For optional vars, uncomment and set as needed
#
# In production, prefer ExternalSecret + Vault over this file.
# This file is for local-dev + staging bootstrap only.
# ════════════════════════════════════════════════════════════════════

# ─── Core Database ──────────────────────────────────────────────────
POSTGRES_USER=hsaai
POSTGRES_PASSWORD=__REQUIRED__
POSTGRES_DB=hsaai
POSTGRES_SUPERUSER_PASSWORD=__REQUIRED__
DATABASE_URL=postgresql+psycopg://hsaai:__REQUIRED__@postgres:5432/hsaai

# ─── Auth / Keycloak ────────────────────────────────────────────────
JWT_SECRET=__REQUIRED_AT_LEAST_32_CHARS__
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_ISSUER=http://keycloak:8080/realms/hsaai
KEYCLOAK_REALM=hsaai
KEYCLOAK_CLIENT_ID=hsaai-frontend
KEYCLOAK_CLIENT_SECRET=__REQUIRED__
KEYCLOAK_AUDIENCE=hsaai-api
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=__REQUIRED__

# ─── Data Encryption ────────────────────────────────────────────────
DATA_ENCRYPTION_KEY=__REQUIRED_FERNET_KEY__
FIELD_ENCRYPTION_ENABLED=true
AUDIT_HMAC_SECRET=__REQUIRED_64_CHARS__

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=__REQUIRED__
CACHE_REDIS_URL=redis://redis:6379/1
AUDIT_REDIS_URL=redis://redis:6379/2
BUDGET_REDIS_URL=redis://redis:6379/3

# ─── Qdrant Vector DB ───────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=__REQUIRED__
QDRANT_COLLECTION=hsaai_knowledge

# ─── Neo4j Knowledge Graph ──────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=__REQUIRED__

# ─── MinIO / Object Storage ────────────────────────────────────────
MINIO_ROOT_USER=hsaai_minio_admin
MINIO_ROOT_PASSWORD=__REQUIRED__
AWS_ACCESS_KEY_ID=hsaai_minio_admin
AWS_SECRET_ACCESS_KEY=__REQUIRED__
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=http://minio:9000

# ─── Vault ──────────────────────────────────────────────────────────
VAULT_ADDR=https://vault:8200
VAULT_CACERT=/vault/tls/ca.crt
VAULT_ROLE_ID=__REQUIRED__
VAULT_SECRET_ID=__REQUIRED__

# ─── Patroni / Replication ──────────────────────────────────────────
REPLICATION_PASSWORD=__REQUIRED__
REWIND_PASSWORD=__REQUIRED__
PATRONI_API_PASSWORD=__REQUIRED__
PATRONI_API_USER=patroni

# ─── LLM / AI ───────────────────────────────────────────────────────
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_BASE_URL=http://ollama:11434
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LLM_GATEWAY_URL=http://llm_gateway:8090
RAG_ENGINE_URL=http://rag_engine:8030
AI_ALIGNMENT_SERVICE_TOKEN=__REQUIRED__

# External AI (only if ALLOW_EXTERNAL_AI=true)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ─── Service URLs ───────────────────────────────────────────────────
BACKEND_CORE_URL=http://backend:8000
AUTH_SERVICE_URL=http://auth_service:8010
API_GATEWAY_URL=http://api_gateway:8060

# ─── Security / Feature Flags ───────────────────────────────────────
APP_ENV=production
AUTH_REQUIRED=true
ALLOW_DEV_RBAC=false
ALLOW_DEV_AUTH=false
ALLOW_EXTERNAL_AI=false
ALLOW_EXTERNAL_APIS=false
ALLOW_WEAK_SECRETS=false
INTERNAL_ONLY_MODE=true
STRICT_EGRESS_DENY=true
USE_ALEMBIC=true

# ─── Audit Logging ──────────────────────────────────────────────────
AUDIT_LOG_ENABLED=true
AUDIT_LOG_DIR=/data/audit_logs
AUDIT_RETENTION_DAYS=2555
AUDIT_MAX_FILE_SIZE_MB=100
SIEM_ENABLED=false
SIEM_BACKEND=splunk
SIEM_URL=
SIEM_TOKEN=

# ─── Domain / TLS ───────────────────────────────────────────────────
DOMAIN_NAME=hsaai.local
CORS_ALLOW_ORIGINS=https://hsaai.local
COOKIE_DOMAIN=hsaai.local

# ─── Observability ──────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_RETENTION=30d
LOKI_RETENTION=30d

# ─── Rate Limiting ──────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=5

# ─── Connection Pool ────────────────────────────────────────────────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
