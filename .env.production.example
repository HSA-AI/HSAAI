# HSAAI Enterprise AI Platform - Production Environment Example
APP_ENV=production
ENVIRONMENT=production
DOMAIN_NAME=ai.example.com
SSL_EMAIL=admin@example.com
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Database
POSTGRES_DB=hsaai
POSTGRES_USER=hsaai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://hsaai:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/hsaai
DIRECT_URL=postgresql+psycopg://hsaai:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/hsaai
REDIS_URL=redis://redis:6379/0

# Keycloak Production Realm
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG_KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=hsaai
KEYCLOAK_CLIENT_ID=hsaai-web
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_REAL_KEYCLOAK_CLIENT_SECRET
KEYCLOAK_ISSUER=https://ai.example.com/auth/realms/hsaai
KEYCLOAK_AUDIENCE=hsaai-api
VERIFY_KEYCLOAK_AUDIENCE=true
AUTH_REQUIRED=true
ALLOW_DEV_RBAC=false

# CORS / Upload / Rate limiting
CORS_ALLOW_ORIGINS=https://ai.example.com
RATE_LIMIT_PER_MINUTE=120
RAG_MAX_UPLOAD_BYTES=52428800
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# Qdrant Persistent Vector DB
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=CHANGE_ME_QDRANT_API_KEY_OR_LEAVE_EMPTY_IF_INTERNAL_ONLY
QDRANT_COLLECTION=hsaai_knowledge
QDRANT_VECTOR_SIZE=384
REQUIRE_QDRANT=true

# LLM / FinOps
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_INPUT_COST_PER_1K=0
LLM_OUTPUT_COST_PER_1K=0
MONTHLY_AI_BUDGET=1000
COST_ALERT_THRESHOLD=0.8

# Human-in-the-Loop notifications
APPROVAL_EMAIL_FROM=approvals@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=approvals@example.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
APPROVAL_WEBHOOK_URL=

# Enterprise Connectors - SAP
SAP_BASE_URL=https://sap.example.com
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_USERNAME=
SAP_PASSWORD=
SAP_SYSTEM_ID=
SAP_CREDENTIALS_REF=

# Enterprise Connectors - SharePoint / Microsoft Graph
SHAREPOINT_BASE_URL=https://graph.microsoft.com/v1.0
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_CREDENTIALS_REF=

# Enterprise Connectors - Active Directory / LDAP
AD_URL=ldaps://ad.example.com:636
AD_BASE_URL=ldaps://ad.example.com:636
AD_DOMAIN=example.local
AD_BIND_DN=CN=hsaai-service,OU=Service Accounts,DC=example,DC=local
AD_BIND_PASSWORD=
AD_BASE_DN=DC=example,DC=local
AD_CREDENTIALS_REF=

# Monitoring
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Knowledge Graph / Neo4j
KNOWLEDGE_GRAPH_ENABLED=true
GRAPH_INGESTION_ENABLED=true
GRAPH_RAG_BRIDGE_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-strong-neo4j-password

# ─── Storage Paths (FIX CRITICAL-2) ────────────────────────────────────────
# All persistent storage paths are configurable. Defaults point to /data which
# should be a mounted persistent volume in production. Override per-environment
# as needed. The following services read these paths at startup:
#   - rag_engine:           LOCAL_FILE_STORAGE, RAG_EVENT_DB
#   - backend_core/audit:   AUDIT_LOG_DIR
#   - backend_core/security: ENCRYPTION_SALT_PATH
#   - backend_core/agent_marketplace: AGENT_MARKETPLACE_FILE
#   - backend_core/mdm:     MDM_STORAGE_FILE
LOCAL_FILE_STORAGE=/data/local_uploads
RAG_EVENT_DB=/data/rag_events.db
AUDIT_LOG_DIR=/data/audit_logs
ENCRYPTION_SALT_PATH=/data/encryption.salt
AGENT_MARKETPLACE_FILE=/data/agent_marketplace.json
MDM_STORAGE_FILE=/data/mdm.json

# Optional: Tesseract OCR data path (for document_ai service)
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
