from __future__ import annotations

from collections.abc import Generator
from typing import Any

from sqlalchemy import create_engine, event, text
from sqlalchemy.orm import DeclarativeBase, Session, sessionmaker

from services.model_training.config import settings


# ============================================================
# Database Engine
# ============================================================

engine = create_engine(
    settings.database_url,
    pool_pre_ping=True,
    future=True,
)


# ============================================================
# Session Factory
# ============================================================

SessionLocal = sessionmaker(
    bind=engine,
    autoflush=False,
    autocommit=False,
    expire_on_commit=False,
    future=True,
)


# ============================================================
# SQLAlchemy Base
# ============================================================

class Base(DeclarativeBase):
    pass


# ============================================================
# Tenant / PostgreSQL RLS
# ============================================================

TENANT_ID_MAX_LENGTH = 64
TENANT_SESSION_KEY = "tenant_id"


def validate_tenant_id(tenant_id: str) -> str:
    """
    Validate tenant_id.

    tenant_id MUST come from authenticated JWT/service claims.
    Never accept an arbitrary client supplied tenant as trusted input.
    """
    if tenant_id is None:
        raise ValueError("tenant_id is required")

    value = str(tenant_id).strip()

    if not value:
        raise ValueError("tenant_id cannot be empty")

    if len(value) > TENANT_ID_MAX_LENGTH:
        raise ValueError("tenant_id exceeds maximum length")

    return value


def set_tenant_id(db: Session, tenant_id: str) -> None:
    """
    Store tenant context on the SQLAlchemy Session and immediately
    apply it to the current PostgreSQL transaction.

    SET LOCAL is intentionally used so the setting cannot leak
    permanently to another pooled PostgreSQL connection.
    """
    tenant_id = validate_tenant_id(tenant_id)

    db.info[TENANT_SESSION_KEY] = tenant_id

    db.execute(
        text(
            "SELECT set_config("
            "'app.tenant_id', "
            ":tenant_id, "
            "true"
            ")"
        ),
        {"tenant_id": tenant_id},
    )


def get_session_tenant_id(db: Session) -> str | None:
    """
    Return tenant stored on the SQLAlchemy Session.
    """
    value = db.info.get(TENANT_SESSION_KEY)

    if value is None:
        return None

    return str(value)


def get_current_tenant_id(db: Session) -> str | None:
    """
    Return the tenant currently active in PostgreSQL.
    """
    result = db.execute(
        text(
            "SELECT current_setting("
            "'app.tenant_id', "
            "true"
            ")"
        )
    )

    value = result.scalar()

    if value is None or value == "":
        return None

    return str(value)


def require_tenant_id(db: Session) -> str:
    """
    Require a configured tenant context.
    """
    tenant_id = get_session_tenant_id(db)

    if not tenant_id:
        tenant_id = get_current_tenant_id(db)

    if not tenant_id:
        raise RuntimeError(
            "PostgreSQL RLS tenant context is not configured"
        )

    return tenant_id


# ============================================================
# Automatically restore SET LOCAL after every transaction
# ============================================================

@event.listens_for(Session, "after_begin")
def _apply_tenant_after_begin(
    session: Session,
    transaction: Any,
    connection,
) -> None:
    """
    Re-apply the tenant context whenever SQLAlchemy starts a new
    database transaction.

    This is necessary because SET LOCAL is cleared by COMMIT/ROLLBACK.
    """
    tenant_id = session.info.get(TENANT_SESSION_KEY)

    if not tenant_id:
        return

    connection.execute(
        text(
            "SELECT set_config("
            "'app.tenant_id', "
            ":tenant_id, "
            "true"
            ")"
        ),
        {"tenant_id": validate_tenant_id(tenant_id)},
    )


# ============================================================
# FastAPI Database Dependency
# ============================================================

def get_db() -> Generator[Session, None, None]:
    """
    Standard SQLAlchemy dependency.

    IMPORTANT:
    The tenant-aware API dependency must call set_tenant_id()
    before executing tenant protected queries.
    """
    db = SessionLocal()

    try:
        yield db
    except Exception:
        db.rollback()
        raise
    finally:
        db.close()


# ============================================================
# Tenant-aware Database Dependency
# ============================================================

def get_tenant_db(
    tenant_id: str,
) -> Generator[Session, None, None]:
    """
    Internal tenant-aware database dependency/helper.
    """
    tenant_id = validate_tenant_id(tenant_id)

    db = SessionLocal()

    try:
        db.info[TENANT_SESSION_KEY] = tenant_id

        # Start transaction and apply RLS context.
        set_tenant_id(db, tenant_id)

        yield db

    except Exception:
        db.rollback()
        raise

    finally:
        db.close()


# ============================================================
# Health Check
# ============================================================

def check_database_connection() -> bool:
    """
    Verify PostgreSQL connectivity.
    """
    try:
        with engine.connect() as connection:
            connection.execute(text("SELECT 1"))
        return True
    except Exception:
        return False


def database_health() -> dict[str, object]:
    """
    Return PostgreSQL health information.
    """
    try:
        with engine.connect() as connection:
            connection.execute(text("SELECT 1"))

        return {
            "status": "healthy",
            "database": "postgresql",
        }

    except Exception as exc:
        return {
            "status": "unhealthy",
            "database": "postgresql",
            "error": str(exc),
        }
