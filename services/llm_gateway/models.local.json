{
  "default": "qwen3:8b",
  "provider": "ollama",
  "local_only": true,
  "models": {
    "arabic": {
      "name": "qwen3:8b",
      "purpose": "Arabic enterprise knowledge, policies, procedures, and HR/administrative answers",
      "sensitivity": [
        "internal",
        "restricted",
        "confidential"
      ],
      "max_context_tokens": 32768
    },
    "general": {
      "name": "llama3.1:8b-instruct",
      "purpose": "General internal assistant tasks",
      "sensitivity": [
        "internal"
      ],
      "max_context_tokens": 8192
    },
    "coding": {
      "name": "codellama:7b-instruct",
      "purpose": "Source code review, scripting, SQL, DevOps, and developer support",
      "sensitivity": [
        "internal",
        "restricted"
      ],
      "max_context_tokens": 16384
    },
    "fast": {
      "name": "mistral:7b-instruct",
      "purpose": "Fast low-risk summarization and drafting",
      "sensitivity": [
        "internal"
      ],
      "max_context_tokens": 8192
    }
  },
  "routing_rules": [
    {
      "when": {
        "contains_any": [
          "كود",
          "برمجة",
          "sql",
          "python",
          "javascript",
          "typescript",
          "docker",
          "kubernetes",
          "api"
        ]
      },
      "model_key": "coding"
    },
    {
      "when": {
        "contains_any": [
          "سياسة",
          "إجراء",
          "موارد بشرية",
          "عقد",
          "مذكرة",
          "تعميم",
          "لائحة",
          "محضر",
          "sap",
          "مالية",
          "مشتريات"
        ]
      },
      "model_key": "arabic"
    },
    {
      "when": {
        "sensitivity_any": [
          "restricted",
          "confidential",
          "high"
        ]
      },
      "model_key": "arabic"
    },
    {
      "when": {
        "contains_any": [
          "اختصر",
          "لخص",
          "draft",
          "summary"
        ]
      },
      "model_key": "fast"
    }
  ],
  "default_key": "arabic",
  "external_models": {
    "openai_gpt": {
      "provider": "openai",
      "name": "gpt-4.1-mini",
      "purpose": "Optional non-sensitive advanced reasoning via OpenAI API"
    },
    "anthropic_claude": {
      "provider": "anthropic",
      "name": "claude-3-5-sonnet-latest",
      "purpose": "Optional non-sensitive long-form analysis via Anthropic API"
    },
    "google_gemini": {
      "provider": "google",
      "name": "gemini-1.5-pro",
      "purpose": "Optional non-sensitive multimodal/enterprise tasks via Gemini API"
    }
  },
  "external_routing_rules": [
    {
      "when": {
        "contains_any": [
          "external",
          "api خارجي",
          "نموذج خارجي",
          "معقد جدا",
          "advanced reasoning"
        ]
      },
      "model_key": "openai_gpt"
    },
    {
      "when": {
        "contains_any": [
          "تحليل طويل",
          "وثيقة طويلة",
          "long analysis"
        ]
      },
      "model_key": "anthropic_claude"
    },
    {
      "when": {
        "contains_any": [
          "gemini",
          "google"
        ]
      },
      "model_key": "google_gemini"
    }
  ]
}