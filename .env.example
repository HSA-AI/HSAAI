# HSAAI Environment Configuration
# =================================
# Copy this file to .env and fill in your secrets.

# ─── LLM Configuration ──────────────────────────────────────
HSAAI_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
HSAAI_FALLBACK_MODEL=gpt-4o
HSAAI_QUANTIZATION=awq
HSAAI_VLLM_ENABLED=true
HSAAI_GPU_MEM_UTIL=0.90
HSAAI_MAX_MODEL_LEN=8192
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Semantic Cache ─────────────────────────────────────────
HSAAI_CACHE_ENABLED=true
HSAAI_CACHE_SIM_THRESHOLD=0.95
HSAAI_CACHE_TTL=86400

# ─── Per-Tenant Budgets ─────────────────────────────────────
HSAAI_DEFAULT_BUDGET=1000000

# ─── Database ───────────────────────────────────────────────
POSTGRES_USER=hsaai
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://hsaai:${POSTGRES_PASSWORD}@postgres:5432/hsaai

# ─── Vector DB ──────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333

# ─── Knowledge Graph ────────────────────────────────────────
NEO4J_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ─── Event Bus ──────────────────────────────────────────────
EVENT_BUS_BACKEND=kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ─── Observability ──────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
DEPLOY_ENV=production

# ─── Identity & Security ────────────────────────────────────
KEYCLOAK_PASSWORD=
VAULT_TOKEN=
GRAFANA_PASSWORD=

# ─── Prompt Firewall ────────────────────────────────────────
PROMPT_FIREWALL_THRESHOLD=0.5

# ─── LLM Gateway URLs (for internal services) ───────────────
LLM_GATEWAY_URL=http://llm-gateway:8090
RAG_SERVICE_URL=http://rag-service:8001
SAFETY_REDIS_URL=redis://redis:6379/3
CACHE_REDIS_URL=redis://redis:6379/1
BUDGET_REDIS_URL=redis://redis:6379/2
